# Copy to agents/data_team/.env (adk web loads it) or export these in your shell.

# --- Option A (default): Gemini through a free AI Studio key ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-ai-studio-key-here

# --- Option B: Vertex AI (switch when you have Vertex credits) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model for all three agents
GEMINI_MODEL=gemini-3.8-flash

# Optional: copy every run folder (payload files, charts, PDF) to Cloud Storage
# OUTPUT_BUCKET=your-bucket-name

# Live agent graph page (http://localhost:8765). Set to 0 to turn it off.
# LIVE_GRAPH=1
# LIVE_GRAPH_PORT=8765
